/* ---------- tokens (docs/ART_DIRECTION.md): the palette lives here, nowhere else ---------- */
:root {
    --cal: #fbf4e2;
    --sol: #f2b632;
    --chita-claro: #ef6b6f;
    --cal-mudo: #c9b79a;
    --tinta: #2a1a12;
    --chita-escuro: #a8232d;
    --mandacaru-claro: #9fcf7a;
    --tinta-mudo: #6b4f3d;
    --borda: #4a352a;
    --mandacaru-escuro: #3d6229;
    --papel: #f3e6c8;
    --cal-suave: #e6d8bc;
    --noite: #1d1410;
    --alerta: #f0535a;
    --chita-fundo: #7d1a22;
    --noite-3: #3a281d;
    --noite-0: #120b08;
    --noite-2: #2a1d17;
    --preto: #000000;
    --branco: #ffffff;
    --transp: rgba(0, 0, 0, 0);
    --anil: #2f5d8c;
    --anil-claro: #7fb0e0;
    /* touch targets: ≥ 64 px on the 540 px panel ≈ 50 dp on a 1080p phone */
    --alvo: 64px;
    --branco-14: rgba(255, 255, 255, 0.14);
    --branco-28: rgba(255, 255, 255, 0.28);
    --branco-30: rgba(255, 255, 255, 0.3);
    --branco-35: rgba(255, 255, 255, 0.35);
    --branco-40: rgba(255, 255, 255, 0.4);
    --branco-45: rgba(255, 255, 255, 0.45);
    --branco-6: rgba(255, 255, 255, 0.06);
    --cal-10: rgba(251, 244, 226, 0.1);
    --cal-20: rgba(251, 244, 226, 0.2);
    --cal-35: rgba(251, 244, 226, 0.35);
    --cal-40: rgba(251, 244, 226, 0.4);
    --cal-55: rgba(251, 244, 226, 0.55);
    --cal-60: rgba(251, 244, 226, 0.6);
    --cal-75: rgba(251, 244, 226, 0.75);
    --cal-mudo-35: rgba(201, 183, 154, 0.35);
    --chita-claro-22: rgba(239, 107, 111, 0.22);
    --chita-claro-45: rgba(239, 107, 111, 0.45);
    --chita-claro-60: rgba(239, 107, 111, 0.6);
    --noite-0-60: rgba(18, 11, 8, 0.6);
    --noite-0-70: rgba(18, 11, 8, 0.7);
    --noite-0-85: rgba(18, 11, 8, 0.85);
    --noite-0-88: rgba(18, 11, 8, 0.88);
    --noite-0-90: rgba(18, 11, 8, 0.9);
    --noite-0-95: rgba(18, 11, 8, 0.95);
    --noite-2-55: rgba(42, 29, 23, 0.55);
    --noite-2-75: rgba(42, 29, 23, 0.75);
    --noite-2-86: rgba(42, 29, 23, 0.86);
    --noite-2-90: rgba(42, 29, 23, 0.9);
    --noite-55: rgba(29, 20, 16, 0.55);
    --noite-80: rgba(29, 20, 16, 0.8);
    --noite-86: rgba(29, 20, 16, 0.86);
    --noite-90: rgba(29, 20, 16, 0.9);
    --noite-92: rgba(29, 20, 16, 0.92);
    --preto-30: rgba(0, 0, 0, 0.3);
    --preto-35: rgba(0, 0, 0, 0.35);
    --preto-50: rgba(0, 0, 0, 0.5);
    --preto-97: rgba(0, 0, 0, 0.97);
    --sol-25: rgba(242, 182, 50, 0.25);
    --tinta-10: rgba(42, 26, 18, 0.1);
    --tinta-25: rgba(42, 26, 18, 0.25);
    --tinta-35: rgba(42, 26, 18, 0.35);
    --tinta-40: rgba(42, 26, 18, 0.4);
    --tinta-45: rgba(42, 26, 18, 0.45);
}

/* Unice: candlelit game UI + aged-paper screens. Colors match the web version.
   Panel is 540 px tall (Ui.ReferenceResolution): 1 px ≈ 0.79 dp on a 1080p phone, so every touch target is ≥ 64 px (≈ 50 dp)
   and text the player reads in a match is ≥ 16 px (≈ 12.6 sp). */
.root {
    flex-grow: 1;
    -unity-font-definition: url("../Fonts/AlegreyaSans-Regular.ttf");
    color: var(--cal);
    font-size: 18px;
}
.layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hidden { display: none; }

/* ---------- shared text ---------- */
.display { -unity-font-definition: url("../Fonts/IMFellEnglishSC-Regular.ttf"); }
.type { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); }
.bold { -unity-font-definition: url("../Fonts/AlegreyaSans-Bold.ttf"); }

/* ---------- paper sheets ---------- */
.overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--noite-0-88); align-items: center; justify-content: center; padding: 16px; }
.sheet-scroll { max-width: 1100px; width: 100%; max-height: 100%; }
.sheet { background-color: var(--papel); color: var(--tinta); border-radius: 4px; border-width: 1px; border-color: var(--tinta-40); padding: 26px 32px; }
.eyebrow { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 14px; letter-spacing: 2px; color: var(--chita-escuro); margin-bottom: 4px; }
.title { -unity-font-definition: url("../Fonts/IMFellEnglishSC-Regular.ttf"); font-size: 64px; color: var(--tinta); margin-bottom: 6px; }
.title-md { font-size: 44px; }
.title-red { color: var(--chita-escuro); }
.title-win { color: var(--mandacaru-escuro); }
.lede { font-size: 20px; white-space: normal; margin-bottom: 14px; }
.muted { color: var(--tinta-mudo); font-size: 16px; white-space: normal; }
.lbl { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 13px; letter-spacing: 1px; color: var(--tinta-mudo); margin-bottom: 4px; }
.row { flex-direction: row; align-items: center; }
.wrap { flex-wrap: wrap; }
.grow { flex-grow: 1; flex-shrink: 1; }
.cols { flex-direction: row; }
.col { flex-grow: 1; flex-basis: 0; margin-right: 24px; }
.gap { margin-top: 14px; }

.field { background-color: var(--branco-40); border-width: 1px; border-color: var(--tinta-40); border-radius: 4px; color: var(--tinta); font-size: 20px; padding: 6px 10px; min-height: var(--alvo); margin: 0; }
.field > .unity-text-field__input, .field .unity-base-text-field__input { background-color: var(--transp); border-width: 0; color: var(--tinta); font-size: 20px; padding: 0; -unity-font-definition: url("../Fonts/AlegreyaSans-Bold.ttf"); }
.code-field .unity-base-text-field__input { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); letter-spacing: 4px; font-size: 22px; }

.btn { background-color: var(--tinta); color: var(--papel); border-width: 0; border-radius: 4px; padding: 10px 22px; min-height: var(--alvo); font-size: 17px; -unity-font-definition: url("../Fonts/AlegreyaSans-Bold.ttf"); letter-spacing: 1px; margin: 0 10px 0 0; }
.btn:hover { background-color: var(--chita-escuro); }
.btn:active { background-color: var(--chita-fundo); }
.btn:disabled { opacity: 0.45; }
.btn-ghost { background-color: var(--transp); color: var(--tinta); border-width: 2px; border-color: var(--tinta); }
.btn-ghost:hover { background-color: var(--tinta-10); }
.btn-link { background-color: var(--transp); color: var(--chita-escuro); padding: 6px 4px; min-height: var(--alvo); }
.btn-link:hover { background-color: var(--transp); color: var(--tinta); }
.net { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 15px; color: var(--tinta-mudo); white-space: normal; margin-top: 10px; }
.net-err { color: var(--chita-escuro); }

.rules { flex-direction: row; flex-wrap: wrap; margin-top: 12px; }
.rule { width: 32%; margin-right: 1%; margin-bottom: 10px; border-top-width: 2px; border-color: var(--tinta-35); padding-top: 6px; }
.rule-t { -unity-font-definition: url("../Fonts/IMFellEnglishSC-Regular.ttf"); font-size: 20px; }
.rule-b { font-size: 15px; white-space: normal; }
.rule-red { border-color: var(--chita-escuro); }
.rule-red .rule-t { color: var(--chita-escuro); }
.rule-green { border-color: var(--mandacaru-escuro); }
.rule-green .rule-t { color: var(--mandacaru-escuro); }

/* waiting room */
.code { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); color: var(--chita-escuro); letter-spacing: 6px; }
.prow { flex-direction: row; align-items: center; padding: 6px 10px; margin-bottom: 6px; background-color: var(--branco-30); border-radius: 3px; }
.prow-me { border-width: 2px; border-color: var(--tinta); }
.prow-bots { background-color: var(--transp); border-width: 1px; border-color: var(--tinta-40); color: var(--tinta-mudo); }
.pname { -unity-font-definition: url("../Fonts/AlegreyaSans-Bold.ttf"); font-size: 18px; flex-grow: 1; margin-left: 10px; }
.pstate { -unity-font-definition: url("../Fonts/AlegreyaSans-Bold.ttf"); font-size: 13px; letter-spacing: 1px; color: var(--tinta-mudo); }
.pstate-ok { color: var(--mandacaru-escuro); }
.pts { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 20px; }
.stepper { flex-direction: row; align-items: center; margin-right: 18px; }
.step-btn { width: 64px; min-height: var(--alvo); padding: 0; margin: 0 6px; background-color: var(--branco-45); color: var(--tinta); font-size: 22px; border-radius: 4px; border-width: 0; }
.step-val { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 20px; min-width: 24px; -unity-text-align: middle-center; }
.preview { width: 170px; height: 170px; border-radius: 85px; background-color: var(--noite-3); margin-right: 16px; }
.opt { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 6px; }
.opt-l { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 12px; color: var(--tinta-mudo); width: 110px; }
.cy { flex-direction: row; align-items: center; flex-grow: 1; background-color: var(--branco-35); border-radius: 4px; }
.cy-btn { width: 64px; min-height: var(--alvo); padding: 0; margin: 0; background-color: var(--transp); color: var(--tinta); font-size: 22px; border-width: 0; }
.cy-val { flex-grow: 1; -unity-text-align: middle-center; -unity-font-definition: url("../Fonts/AlegreyaSans-Bold.ttf"); font-size: 16px; }
.sws { flex-direction: row; flex-wrap: wrap; flex-grow: 1; }
.sw { width: 64px; height: 64px; border-radius: 32px; margin: 0 6px 4px 0; border-width: 2px; border-color: var(--tinta-25); padding: 0; min-height: var(--alvo); }
.sw-on { border-width: 3px; border-color: var(--tinta); }
.tabbar { flex-direction: row; flex-wrap: wrap; margin-bottom: 10px; }
.tabbtn { background-color: var(--preto-30); color: var(--cal-mudo); border-width: 0; border-radius: 8px; padding: 7px 12px; margin: 0 6px 6px 0; min-height: var(--alvo); font-size: 13px; letter-spacing: 1px; -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); }
.tabbtn-on { background-color: var(--sol); color: var(--noite); }
/* on the paper card (My child) the dark tab is invisible: ink text on a light ink wash, ≈10:1 */
.mkid .tabbtn { background-color: var(--tinta-10); color: var(--tinta); }
.mkid .tabbtn-on { background-color: var(--sol); color: var(--noite); }

/* scores */
.srow { flex-direction: row; align-items: center; padding: 4px 10px; margin-bottom: 5px; background-color: var(--branco-28); border-radius: 3px; }
.srank { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); width: 26px; color: var(--tinta-mudo); }
.next { flex-direction: row; align-items: center; padding: 10px 12px; margin: 12px 0; border-width: 1px; border-color: var(--tinta-45); border-radius: 4px; }

/* ---------- in-game HUD ---------- */
.hud-card { background-color: var(--noite-2-86); border-width: 1px; border-color: var(--borda); border-radius: 6px; padding: 8px 12px; }
.hud-tl { position: absolute; left: 14px; top: 12px; min-width: 200px; }
.hud-tr { position: absolute; right: 14px; top: 12px; width: 300px; align-items: stretch; }
.hud-lbl { -unity-font-definition: url("../Fonts/AlegreyaSans-Bold.ttf"); font-size: 16px; letter-spacing: 1px; color: var(--cal-mudo); }
.clock { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 44px; color: var(--cal); }
.clock-low { color: var(--alerta); }
.phase { font-size: 16px; color: var(--cal-mudo); }
.where { font-size: 16px; color: var(--cal); }
.roomline { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 16px; color: var(--sol); }
.role-t { -unity-font-definition: url("../Fonts/IMFellEnglishSC-Regular.ttf"); font-size: 22px; }
.role-unice .role-t { color: var(--chita-claro); }
.role-holder .role-t { color: var(--sol); }
.role-out .role-t { color: var(--cal-mudo); }
.role-g { font-size: 16px; white-space: normal; color: var(--cal-suave); }
.meter { height: 10px; background-color: var(--noite-0); border-width: 1px; border-color: var(--borda); border-radius: 2px; margin-top: 4px; overflow: hidden; }
.meter-fill { height: 100%; width: 0; background-color: var(--chita-claro); }
.meter-noise .meter-fill { background-color: var(--sol); }
.note { font-size: 16px; color: var(--cal-mudo); white-space: normal; margin-top: 3px; }
.mini { height: 140px; margin-top: 6px; background-color: var(--noite-0); border-radius: 4px; }
.hud-btn { background-color: var(--noite-2-90); color: var(--cal); border-width: 1px; border-color: var(--borda); border-radius: 5px; font-size: 16px; letter-spacing: 1px; -unity-font-definition: url("../Fonts/AlegreyaSans-Bold.ttf"); padding: 6px 10px; min-height: var(--alvo); min-width: 64px; margin: 0 0 0 6px; }
.hud-btns { position: absolute; right: 330px; top: 12px; flex-direction: row; }
.plist { position: absolute; right: 330px; top: 84px; width: 270px; }
/* the rows scroll so 8 players (64 px rows with mute buttons) stay above the bottom of a 540 px panel */
.plist-rows { max-height: 230px; }
.plrow { flex-direction: row; align-items: center; margin-bottom: 4px; padding: 2px 4px; border-radius: 4px; }
.plrow-pick { background-color: var(--branco-6); min-height: var(--alvo); }
.plrow-pick:hover { background-color: var(--branco-14); }
.plrow-on { background-color: var(--chita-claro-22); }
.plname { -unity-font-definition: url("../Fonts/AlegreyaSans-Bold.ttf"); font-size: 16px; }
.plst { font-size: 16px; color: var(--cal-mudo); }
.plout { opacity: 0.5; }
.tag { font-size: 16px; letter-spacing: 1px; color: var(--cal-mudo); border-width: 1px; border-color: var(--borda); border-radius: 3px; padding: 0 4px; margin-left: 6px; }

.banner { position: absolute; left: 0; right: 0; top: 18%; -unity-text-align: middle-center; -unity-font-definition: url("../Fonts/IMFellEnglishSC-Regular.ttf"); font-size: 40px; white-space: normal; }
.banner-info { color: var(--cal); }
.banner-rose { color: var(--chita-claro); }
.banner-blood { color: var(--alerta); }
.banner-moss { color: var(--mandacaru-claro); }
.banner-candle { color: var(--sol); }
.toasts { position: absolute; left: 14px; top: 190px; width: 340px; }
.toast { background-color: var(--noite-92); border-left-width: 3px; border-color: var(--chita-claro); border-radius: 5px; padding: 6px 10px; margin-bottom: 6px; font-size: 16px; white-space: normal; }
.prompt { position: absolute; bottom: 22px; left: 0; right: 0; align-items: center; }
.prompt-in { background-color: var(--noite-90); border-width: 1px; border-color: var(--borda); border-radius: 22px; padding: 6px 16px; font-size: 17px; }
.pill { position: absolute; top: 14px; left: 0; right: 0; align-items: center; }
.pill-in { background-color: var(--noite-0-85); border-radius: 19px; padding: 4px 18px; -unity-font-definition: url("../Fonts/IMFellEnglishSC-Regular.ttf"); font-size: 22px; color: var(--chita-claro); }
.caption { position: absolute; bottom: 86px; left: 0; right: 0; align-items: center; }
.caption-in { background-color: var(--noite-0-88); border-radius: 15px; padding: 4px 16px; -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 17px; }
.blackout { background-color: var(--preto-97); align-items: center; justify-content: center; }
.count { -unity-font-definition: url("../Fonts/IMFellEnglishSC-Regular.ttf"); font-size: 200px; color: var(--chita-claro); }
.count-sub { font-size: 20px; color: var(--cal-mudo); }
.wlabel { position: absolute; -unity-font-definition: url("../Fonts/AlegreyaSans-Bold.ttf"); font-size: 14px; color: var(--cal); -unity-text-align: middle-center; translate: -50% -50%; -unity-text-outline-width: 1px; -unity-text-outline-color: var(--noite-0-90); }
.fxtext { position: absolute; -unity-font-definition: url("../Fonts/IMFellEnglishSC-Regular.ttf"); -unity-text-align: middle-center; translate: -50% -50%; -unity-text-outline-width: 1px; -unity-text-outline-color: var(--noite-0-95); }
.slat { position: absolute; left: 0; right: 0; height: 12px; background-color: var(--preto-50); }
.pause { background-color: var(--noite-0-70); align-items: center; justify-content: center; }

/* touch controls */
.joy { position: absolute; left: 36px; bottom: 30px; width: 204px; height: 204px; border-radius: 102px; background-color: var(--noite-2-55); border-width: 2px; border-color: var(--cal-mudo-35); }
.joy-knob { position: absolute; left: 66px; top: 66px; width: 72px; height: 72px; border-radius: 36px; background-color: var(--cal-75); }
.acts { position: absolute; right: 30px; bottom: 30px; flex-direction: row; align-items: flex-end; }
.act { width: 108px; height: 108px; border-radius: 54px; background-color: var(--noite-2-75); border-width: 2px; border-color: var(--cal-40); color: var(--cal); font-size: 16px; -unity-font-definition: url("../Fonts/AlegreyaSans-Bold.ttf"); margin-left: 14px; padding: 0; white-space: normal; -unity-text-align: middle-center; }
.act-q { border-color: var(--chita-claro); color: var(--chita-claro); width: 90px; height: 90px; border-radius: 45px; }
.act-r { border-color: var(--sol); color: var(--sol); width: 86px; height: 86px; border-radius: 43px; font-size: 14px; }
.act-s { width: 86px; height: 86px; border-radius: 43px; font-size: 13px; }
.act-icon { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.act-on { background-color: var(--sol); color: var(--noite); }

/* ---------- main menu over the house map ---------- */
.menu { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; }
.menu-page { align-items: center; justify-content: center; max-width: 100%; }
.menu-version { position: absolute; left: 18px; top: 12px; -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 15px; color: var(--cal-75); }
.menu-title { -unity-font-definition: url("../Fonts/IMFellEnglishSC-Regular.ttf"); font-size: 112px; color: var(--cal); -unity-text-align: middle-center; text-shadow: 0px 0px 22px var(--chita-claro-60); margin-bottom: -10px; }
.menu-sub { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 17px; letter-spacing: 5px; color: var(--sol); -unity-text-align: middle-center; margin-bottom: 16px; }
.menu-grid { flex-direction: row; flex-wrap: wrap; justify-content: center; width: 660px; max-width: 100%; }
.mbtn { width: 310px; height: 100px; margin: 9px; padding: 0; background-color: var(--noite-80); border-width: 3px; border-color: var(--cal); border-radius: 14px; color: var(--cal); font-size: 54px; -unity-font-definition: url("../Fonts/IMFellEnglishSC-Regular.ttf"); -unity-text-align: middle-center; }
.mbtn:hover { border-color: var(--sol); color: var(--sol); }
.mbtn:active { background-color: var(--sol-25); }
.mbtn:disabled { opacity: 0.4; }
.mbtn-sm { height: 66px; font-size: 32px; }
.mbtn-wide { width: auto; height: 90px; margin: 14px 0 6px 0; font-size: 48px; }
.mbtn-join { width: 190px; height: 70px; margin: 0 0 0 12px; font-size: 36px; }
.mbtn-back { width: 200px; height: 64px; margin: 16px 0 0 0; font-size: 28px; align-self: center; border-width: 2px; }
/* top right: at 4:3 the bottom-left corner is taken by the settings pills and the menu grid */
.mexit { position: absolute; right: 18px; top: 12px; width: 130px; height: 64px; margin: 0; font-size: 30px; border-width: 2px; }
.menu-foot { position: absolute; left: 0; right: 0; bottom: 22px; flex-direction: row; justify-content: center; }
.mpill { background-color: var(--noite-80); border-width: 2px; border-color: var(--cal-60); border-radius: 24px; color: var(--cal); font-size: 17px; -unity-font-definition: url("../Fonts/AlegreyaSans-Bold.ttf"); padding: 8px 20px; min-height: var(--alvo); margin: 0 6px; }
.mpill:hover { border-color: var(--sol); color: var(--sol); }
.mpanel { width: 700px; max-width: 100%; max-height: 640px; background-color: var(--noite-90); border-width: 3px; border-color: var(--cal); border-radius: 16px; padding: 22px 30px; }
.mpanel-t { -unity-font-definition: url("../Fonts/IMFellEnglishSC-Regular.ttf"); font-size: 52px; color: var(--cal); -unity-text-align: middle-center; margin-bottom: 6px; }
.mnote { font-size: 18px; color: var(--cal-suave); white-space: normal; }
.mnet { margin-top: 10px; -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 16px; color: var(--cal-mudo); }
.mnet.net-err { color: var(--chita-claro); }
.menu-or { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 14px; letter-spacing: 3px; color: var(--cal-mudo); -unity-text-align: middle-center; margin: 14px 0 8px 0; }
.mfield { margin: 0; min-height: 70px; }
.mfield .unity-base-text-field__input { background-color: var(--preto-35); border-width: 2px; border-color: var(--cal-55); border-radius: 10px; color: var(--cal); font-size: 36px; letter-spacing: 8px; -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); -unity-text-align: middle-center; padding: 0 12px; }
.mscroll { max-height: 300px; }
.mrule { margin-bottom: 12px; }
.mrule-t { -unity-font-definition: url("../Fonts/IMFellEnglishSC-Regular.ttf"); font-size: 26px; color: var(--sol); }
.mrule-rose { color: var(--chita-claro); }
.mrule-moss { color: var(--mandacaru-claro); }
.mkid { background-color: var(--papel); color: var(--tinta); border-radius: 8px; padding: 14px 18px; }

/* ---------- waiting room, full screen for a phone on its side ---------- */
.lobby { position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 16px 22px 10px 22px; }
/* wraps to two rows when the screen is too narrow (4:3) instead of squeezing the room code */
.lobby-top { flex-direction: row; flex-wrap: wrap; align-items: center; min-height: 72px; flex-shrink: 0; }
.mbtn-top { width: 130px; height: 64px; margin: 0; font-size: 30px; border-width: 2px; }
.lobby-head { flex-grow: 1; flex-direction: row; align-items: center; justify-content: center; }
.lobby-title { -unity-font-definition: url("../Fonts/IMFellEnglishSC-Regular.ttf"); font-size: 36px; color: var(--cal); margin-right: 16px; text-shadow: 0px 0px 14px var(--noite-0-90); }
.lobby-code { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 40px; letter-spacing: 6px; color: var(--chita-claro); margin-right: 18px; text-shadow: 0px 0px 16px var(--chita-claro-45); }
.lobby-count { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 30px; color: var(--sol); min-width: 70px; margin-left: 12px; -unity-text-align: middle-right; }
.lobby-body { flex-grow: 1; flex-direction: row; margin-top: 8px; }
/* the cards scroll: 8 players + bots are three rows at 16:9 */
.lobby-players { flex-grow: 1; flex-shrink: 1; }
.lobby-cards { flex-direction: row; flex-wrap: wrap; align-content: flex-start; justify-content: center; }
.pcard { width: 150px; min-height: 190px; margin: 7px; padding: 8px 6px; background-color: var(--noite-86); border-width: 2px; border-color: var(--cal-35); border-radius: 14px; align-items: center; justify-content: center; }
.pcard-me { border-width: 3px; border-color: var(--sol); }
.pcard-name { -unity-font-definition: url("../Fonts/AlegreyaSans-Bold.ttf"); font-size: 21px; color: var(--cal); margin-top: 6px; -unity-text-align: middle-center; }
.pcard-st { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 16px; letter-spacing: 2px; color: var(--cal-mudo); margin-top: 2px; }
.pcard-ok { color: var(--mandacaru-claro); }
.pcard-bots { background-color: var(--noite-55); border-color: var(--cal-20); }
.pcard-plus { -unity-font-definition: url("../Fonts/IMFellEnglishSC-Regular.ttf"); font-size: 66px; color: var(--cal); }
.mpanel.lobby-side { width: 340px; max-height: none; margin: 7px 0 7px 14px; padding: 18px 20px; justify-content: center; flex-shrink: 0; }
.mstep { flex-direction: row; align-items: center; margin-bottom: 12px; }
.mstep-l { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 16px; letter-spacing: 3px; color: var(--cal-mudo); flex-grow: 1; }
.mstep-btn { width: 64px; height: 64px; margin: 0; padding: 0; background-color: var(--preto-35); border-width: 2px; border-color: var(--cal-55); border-radius: 10px; color: var(--cal); font-size: 32px; }
.mstep-btn:hover { border-color: var(--sol); color: var(--sol); }
.mstep-v { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 32px; color: var(--cal); width: 58px; -unity-text-align: middle-center; }
/* the kid customizer (styled for paper in "My child") inside the dark side panel: light ink, dark washes, ≥5.6:1 */
.lobby-side .lbl, .lobby-side .opt-l { color: var(--cal-mudo); }
.lobby-side .field { background-color: var(--preto-35); border-color: var(--cal-55); }
.lobby-side .field .unity-base-text-field__input { color: var(--cal); }
.lobby-side .cy { background-color: var(--preto-35); }
.lobby-side .cy-btn, .lobby-side .cy-val { color: var(--cal); }
.lobby-side .btn-ghost { color: var(--cal); border-color: var(--cal); }
.lobby-side .btn-ghost:hover { background-color: var(--cal-10); }
.lobby-side .sw { border-color: var(--cal-35); }
.lobby-side .sw-on { border-color: var(--sol); }
.lobby-status { margin-top: 8px; -unity-text-align: middle-center; }
.mbtn-go { width: auto; height: 64px; margin: 14px 0 0 0; font-size: 44px; }
.mbtn-on { border-color: var(--mandacaru-claro); color: var(--mandacaru-claro); }
.lobby-note { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 16px; color: var(--cal-mudo); -unity-text-align: middle-center; white-space: normal; margin-top: 4px; flex-shrink: 0; }

/* ---------- round result and final score, full screen ---------- */
.result { background-color: var(--noite-0-60); }
.res-head { align-items: center; flex-shrink: 0; }
.res-eyebrow { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 17px; letter-spacing: 5px; color: var(--sol); }
.res-title { -unity-font-definition: url("../Fonts/IMFellEnglishSC-Regular.ttf"); font-size: 52px; color: var(--cal); -unity-text-align: middle-center; white-space: normal; text-shadow: 0px 0px 16px var(--noite-0-90); }
.res-win { color: var(--mandacaru-claro); }
.res-lose { color: var(--chita-claro); }
.res-reason { font-size: 19px; color: var(--cal-suave); -unity-text-align: middle-center; white-space: normal; max-width: 1000px; }
.pcard-rank { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 15px; color: var(--sol); }
.pcard-pts { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 32px; color: var(--cal); }
.pcard-win { border-width: 3px; border-color: var(--mandacaru-claro); }
.res-lbl { -unity-text-align: middle-center; flex-grow: 0; margin-bottom: 4px; }
.res-next { flex-direction: row; align-items: center; justify-content: center; margin: 4px 0; }
.res-next-name { -unity-font-definition: url("../Fonts/IMFellEnglishSC-Regular.ttf"); font-size: 36px; color: var(--chita-claro); margin-left: 10px; }
.res-count { flex-direction: row; align-items: center; justify-content: center; margin-top: 10px; }
.res-count-n { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 46px; color: var(--sol); margin: 0 10px; }
.res-rules { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 16px; color: var(--cal-mudo); white-space: normal; -unity-text-align: middle-center; margin-top: 12px; }

/* "Mute"/"Unmute" for another player's voice (waiting room cards, in-game player list) */
.mute-btn { font-size: 12px; letter-spacing: 1px; padding: 1px 10px; margin: 3px 0 0 0; min-height: var(--alvo); border-width: 1px; }
.mute-btn-on { color: var(--chita-claro); border-color: var(--chita-claro); }

/* ---------- button system: one feedback model for every button ----------
   Two surfaces: dark (.mbtn .mpill .mstep-btn .hud-btn .act) and paper (.btn .btn-ghost .btn-link .tabbtn .cy-btn .step-btn).
   Hover is for mouse, :active is the press for touch and mouse, :focus is keyboard / gamepad (a gold ring on dark, an anil ring on paper). */
.mbtn, .mpill, .mstep-btn, .hud-btn, .act, .btn, .btn-ghost, .btn-link, .tabbtn, .cy-btn, .step-btn, .sw {
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.12s;
}
.mbtn:active, .mpill:active, .mstep-btn:active, .hud-btn:active, .act:active,
.btn:active, .btn-ghost:active, .tabbtn:active, .cy-btn:active, .step-btn:active { scale: 0.96 0.96; }
.mbtn:disabled, .mpill:disabled, .mstep-btn:disabled, .hud-btn:disabled, .act:disabled,
.btn-ghost:disabled, .tabbtn:disabled, .cy-btn:disabled, .step-btn:disabled { opacity: 0.4; }

.mbtn:focus, .mpill:focus, .mstep-btn:focus, .hud-btn:focus, .act:focus { border-color: var(--sol); color: var(--sol); border-width: 3px; }
.mbtn-on:focus { border-color: var(--mandacaru-claro); color: var(--mandacaru-claro); }
.btn:focus, .btn-ghost:focus, .btn-link:focus, .tabbtn:focus, .cy-btn:focus, .step-btn:focus, .sw:focus { border-width: 3px; border-color: var(--anil); }
.lobby-side .btn-ghost:focus, .lobby-side .cy-btn:focus, .lobby-side .sw:focus { border-color: var(--sol); }

/* ---------- the story: a full-screen animation (StoryScreen) ---------- */
.story { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--noite-0); }
.story-stage { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; }
.story-backdrop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-size: cover; background-position: center; unity-background-image-tint-color: rgb(190, 175, 160); }
.story-world { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.story-prop { position: absolute; }
.story-sepia { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--papel); opacity: 0; }
.story-vignette { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-image: resource("Art/vignette"); background-size: 100% 100%; unity-background-image-tint-color: var(--noite-0-88); }
.story-flash { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--branco); opacity: 0; }
.story-title { position: absolute; left: 0; right: 0; top: 10px; -unity-font-definition: url("../Fonts/IMFellEnglishSC-Regular.ttf"); font-size: 40px; color: var(--cal); -unity-text-align: middle-center; text-shadow: 0px 0px 14px var(--noite-0-95); }
.story-dots { position: absolute; left: 0; right: 0; top: 62px; flex-direction: row; justify-content: center; }
.story-dot { width: 10px; height: 10px; border-radius: 5px; margin: 0 5px; background-color: var(--cal-35); }
.story-dot-on { background-color: var(--sol); }
.story-bubble { position: absolute; background-color: var(--papel); color: var(--tinta); border-width: 2px; border-color: var(--tinta); border-radius: 12px; padding: 3px 12px; font-size: 20px; -unity-font-definition: url("../Fonts/AlegreyaSans-Bold.ttf"); white-space: nowrap; }
.story-cardrow { position: absolute; left: 0; right: 0; bottom: 14px; align-items: center; }
.story-card { background-color: var(--papel); border-width: 2px; border-color: var(--tinta); border-radius: 6px; padding: 10px 28px; min-width: 420px; max-width: 94%; align-items: center; }
.story-line { color: var(--tinta); font-size: 19px; -unity-text-align: middle-center; white-space: normal; transition-property: opacity; transition-duration: 0.35s; }
.story-hint { -unity-font-definition: url("../Fonts/CourierPrime-Bold.ttf"); font-size: 14px; color: var(--tinta-mudo); margin-top: 4px; white-space: normal; -unity-text-align: middle-center; }
.story-card .mbtn-back { margin: 8px 0 0 0; border-color: var(--tinta); color: var(--tinta); background-color: var(--sol); }
.story-card .mbtn-back:focus, .story-card .mbtn-back:hover { color: var(--noite); border-color: var(--noite); }
